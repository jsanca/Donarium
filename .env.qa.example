# QA Environment — reference values only.
# compose.qa.yml has its own hardcoded defaults and does not require this file.
# These are documented here so QA/test scripts can connect externally.

# Donarium API base URL for functional tests
DONARIUM_QA_URL=http://127.0.0.1:18080

# PostgreSQL connection string for direct database inspection
QA_DATABASE_URL=postgres://donarium_qa:donarium_qa@127.0.0.1:15432/donarium_qa?sslmode=disable
